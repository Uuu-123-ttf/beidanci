// ============================================================
// 背单词 - Prisma Schema
// 约定：DB 字段 snake_case（@map），Prisma 字段 camelCase
// 主键统一 cuid() 字符串，避免自增 id 被枚举
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- 用户 ----------
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  name         String? // 显示名，用于个人设置 / 排行榜
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  userWords  UserWord[]
  wordBooks  WordBook[]
  reviewLogs ReviewLog[]
  checkIns   CheckIn[]

  @@map("users")
}

// ---------- 单词（全局共享词典） ----------
// 不同用户、不同词书共享同一批 Word，学习进度记录在 UserWord
model Word {
  id        String   @id @default(cuid())
  spelling  String   @unique // 统一转小写后存储，从存储层保证“单词不区分大小写”
  phonetic  String? // 音标（P2 发音朗读用）
  meaning   String // 释义（多条可用换行分隔）
  example   String? // 例句
  // ---- 粘贴导入的扩展卡片字段（对应 types/card.ts 的 ParsedCard）----
  partOfSpeech    String? @map("part_of_speech") // 词性，如 v. / n. / adj.
  collocations    Json? // 核心词伙：[{ en, zh? }]
  examples        Json? // 词伙例句：[{ en, zh? }]
  writingPosition String? @map("writing_position") // 写作定位
  substitutions   String? // 替换与避坑
  upgrades        Json? // 升级替换：[{ word, note? }]
  upgradeExamples Json?   @map("upgrade_examples") // 升级例句：[{ en, zh? }]
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  userWords  UserWord[]
  reviewLogs ReviewLog[]
  wordBooks  WordBookWord[]

  @@map("words")
}

// ---------- 词书 ----------
model WordBook {
  id        String   @id @default(cuid())
  name      String
  ownerId   String   @map("owner_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  owner User           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  words WordBookWord[]

  @@index([ownerId])
  @@map("word_books")
}

// 词书 ⇄ 单词 多对多（含词书内顺序）
model WordBookWord {
  wordBookId String   @map("word_book_id")
  wordId     String   @map("word_id")
  position   Int      @default(0) // 单词在词书中的顺序
  addedAt    DateTime @default(now()) @map("added_at")

  wordBook WordBook @relation(fields: [wordBookId], references: [id], onDelete: Cascade)
  word     Word     @relation(fields: [wordId], references: [id], onDelete: Cascade)

  @@id([wordBookId, wordId])
  @@index([wordId])
  @@map("word_book_words")
}

// ---------- 用户对单词的学习状态（SM-2 核心） ----------
model UserWord {
  userId String @map("user_id")
  wordId String @map("word_id")

  // 掌握程度：0=新词，1=学习中，2=已掌握（“掌握单词数”统计 proficiency >= 2）
  proficiency Int @default(0)

  // SM-2 字段
  easinessFactor Float    @default(2.5) @map("easiness_factor") // EF，下限 1.3
  interval       Int      @default(0) @map("interval") // 当前复习间隔（天）
  repetitions    Int      @default(0) @map("repetitions") // 连续答对次数
  lapses         Int      @default(0) @map("lapses") // 遗忘次数

  reviewCount    Int       @default(0) @map("review_count") // 总复习次数（含遗忘）
  nextReviewAt   DateTime  @default(now()) @map("next_review_at")
  lastReviewedAt DateTime? @map("last_reviewed_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  word Word @relation(fields: [wordId], references: [id], onDelete: Cascade)

  @@id([userId, wordId])
  @@index([userId, nextReviewAt]) // 查询“今日待复习”
  @@index([wordId])
  @@map("user_words")
}

// ---------- 复习日志（每次评分一条） ----------
model ReviewLog {
  id         String   @id @default(cuid())
  userId     String   @map("user_id")
  wordId     String   @map("word_id")
  rating     Int // 本次评分 0-5（SM-2 quality）
  reviewedAt DateTime @default(now()) @map("reviewed_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  word Word @relation(fields: [wordId], references: [id], onDelete: Cascade)

  @@index([userId, reviewedAt])
  @@map("review_logs")
}

// ---------- 每日打卡 ----------
model CheckIn {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  date      String   @db.VarChar(10) // "YYYY-MM-DD"，用字符串避免时区导致的天数错位
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@map("check_ins")
}
